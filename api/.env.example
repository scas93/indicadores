DATABASE_URL=postgresql+psycopg://indicadores:indicadores@localhost:5433/indicadores
SESSION_SECRET=cambia-esto
# 32 bytes en base64: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
PASSWORD_ENCRYPTION_KEY=
ROOT_DOMAIN=localtest.me
SUPER_ADMIN_SUBDOMAIN=admin
COOKIE_SECURE=false
ADMIN_SESSION_DIAS=1
# Solo para seed.py
SEED_SUPER_ADMIN_USUARIO=
SEED_SUPER_ADMIN_PASSWORD=
# Recuperación de contraseña (Fase 1)
RESEND_API_KEY=
EMAIL_FROM=
PUBLIC_SCHEME=http
PUBLIC_PORT=3000

# Documentos de beneficiarios (Fase 4.3b): bucket PRIVADO de Cloudflare R2, uno por ambiente
# (p. ej. indicadores-docs-staging / indicadores-docs-prod). Distinto de las S3_* de imágenes de marca.
DOCS_S3_ENDPOINT_URL=
DOCS_S3_BUCKET=
DOCS_S3_ACCESS_KEY_ID=
DOCS_S3_SECRET_ACCESS_KEY=
DOCS_S3_REGION=auto
# SOLO desarrollo local sin bucket: guarda en memoria del proceso (nunca en disco). No usar en Railway.
DOCS_ALMACEN_MEMORIA=false
